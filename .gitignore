*.egg-info/
/dist/
/build/
*.log
*.prof

# Local credentials and agent overrides; example files and shared skills stay versioned.
.env
.env.*
!.env.example
!.env.sample
/.secrets/
/.claude/settings.local.json
/.claude/worktrees/
/.claude/sessions/

