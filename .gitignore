# Generated data and machine-specific backups (raw corpora stay versioned).
/dataset/
/data/processed/*
!/data/processed/.gitkeep
/.local/
/logs/
/fonts/font_index.json

# Virtual environments, Python caches, and test tooling.
.venv/
venv/
env/
ENV/
__pycache__/
*.py[cod]
.cache/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.hypothesis/
.ipynb_checkpoints/
.coverage
.coverage.*
coverage.xml
htmlcov/

