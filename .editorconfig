root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{json,jsonl,yml,yaml,md}]
indent_size = 2

# Imported raw sources and licensed downloads are immutable, including whitespace.
[{data/raw,fonts/open}/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
indent_style = unset
indent_size = unset
trim_trailing_whitespace = false
